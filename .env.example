# ===== 复制为 .env 后填写（.env 已被 .gitignore 忽略，不会进仓库）=====

# --- DeepSeek（必填）---
# 去 https://platform.deepseek.com/api_keys 创建，形如 sk-xxxxxxxx
DAFEIYU_DEEPSEEK_API_KEY=
DAFEIYU_DEEPSEEK_MODEL=deepseek-chat
# 官方地址；用中转站时改成中转地址（需兼容 OpenAI chat/completions）
DAFEIYU_DEEPSEEK_BASE_URL=https://api.deepseek.com

# --- OneBot 协议端（NapCat 反向 WS 连到这里）---
DRIVER=~fastapi+~websockets+~httpx
HOST=0.0.0.0
PORT=8080
ONEBOT_ACCESS_TOKEN=

# --- 人设 ---
# 人设文件路径，改 config/persona.txt 即可换性格
DAFEIYU_PERSONA_FILE=config/persona.txt
# 也可以直接内联（填了就覆盖文件）
DAFEIYU_PERSONA_INLINE=

# --- 触发与记忆 ---
DAFEIYU_NICKNAME=["大肥鱼"]
DAFEIYU_GROUP_TRIGGER_KEYWORDS=["大肥鱼"]
DAFEIYU_MAX_HISTORY_TURNS=10
DAFEIYU_HISTORY_TTL_MINUTES=180
DAFEIYU_MAX_REPLY_CHARS=1500
DAFEIYU_SHOW_TYPING=true

# --- 日志 ---
LOG_LEVEL=INFO
