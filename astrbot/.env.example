# 复制成 .env 后填写。 .env 已被 .gitignore 忽略，不会进仓库。
#
# 唯一必填：DeepSeek 的 Key（https://platform.deepseek.com/api_keys）
# 填好后 compose.yml 会把它透传给 AstrBot 容器；
# 在 AstrBot WebUI 里把 provider 的 key 写成 $DEEPSEEK_API_KEY 即可引用它。
DEEPSEEK_API_KEY=

# NapCat 容器以哪个用户的身份读写 QQ 数据目录（一般用当前用户）
#   Linux/macOS:  NAPCAT_UID=$(id -u)  NAPCAT_GID=$(id -g)
#   Windows:      一般保持 1000 即可
NAPCAT_UID=1000
NAPCAT_GID=1000
